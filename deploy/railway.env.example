# Configure these in Railway Variables; never upload the local .env or put secrets in Git.
CLOUD_ALL_IN_ONE=true
CLOUD_SEED=false
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
AIHOT_DATA_DIR=/data
ADMIN_PASSWORD=
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=
# Preserve the local encryption secret when restoring existing model connections.
# MODEL_CREDENTIALS_SECRET=

# Keep calls and collection off until the restored database and subscription are verified.
COLLECT_ENABLED=false
MODEL_CALLS_ENABLED=false
COLLECT_SCHEDULE=rolling
COLLECT_KINDS=rss,web_list,json_list
COLLECT_SKIP_JINA=true
JINA_BODY_FALLBACK=false
FETCH_SCHEDULE_BATCH=12
FETCH_CONCURRENCY=4
FETCH_SPACING_MS=2000
EXTRACT_CONCURRENCY=3
ANALYZE_CONCURRENCY=3
MODEL_MAX_CONCURRENCY=2
MODEL_MIN_SPACING_MS=5000
PUBLIC_SOURCE_EXCERPTS=true
TRANSLATE_SCOPE=published
TRANSLATE_BATCH=2
TRUST_PROXY=true
FEISHU_CONTENT_PUSH_ENABLED=false
INDEXNOW_SUBMIT_ENABLED=false
# RAILWAY_PUBLIC_DOMAIN supplies SITE_URL automatically; set SITE_URL for a custom domain.
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=210
